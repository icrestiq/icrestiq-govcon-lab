{
  "functions": {
    "api/proposal/pdf.js": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/digest/send-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/notion/stale-quote-alert",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/digest/watchlist-alerts",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/go",
      "destination": "/go/index.html"
    },
    {
      "source": "/launch",
      "destination": "/launch/index.html"
    },
    {
      "source": "/sample",
      "destination": "/sample/index.html"
    },
    {
      "source": "/sample/",
      "destination": "/sample/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}