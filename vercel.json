{
  "functions": {
    "api/proposal/pdf.js": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/digest/send-reminders",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/go",
      "destination": "/go/index.html"
    },
    {
      "source": "/sample",
      "destination": "/sample/index.html"
    },
    {
      "source": "/sample/",
      "destination": "/sample/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}